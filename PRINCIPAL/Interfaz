procedure menu_principal;
var
   opcion: byte;
begin
   crear_abrir(arch_alumnos);
   crear_abrir(arch_evaluaciones);
   repeat
      clrscr;
      textcolor(white);
      gotoxy(40,10);
      write('*Bienvenido al sistema de ');
      textcolor(blue);
      writeln('seguimiento de aprendizaje*');
      textcolor(blue);
      gotoxy(52,12);
      write('1- ');
      textcolor(white);
      writeln('Menu Alumno');
      gotoxy(52,14);
      textcolor(blue);
      write('2- ');
      textcolor(white);
      writeln('Menu Seguimiento');
      gotoxy(52,16);
      textcolor(blue);
      write('3- ');
      textcolor(white);
      writeln('Menu Listados');
      gotoxy(52,18);
      textcolor(blue);
      write('4- ');
      textcolor(white);
      writeln('Menu Estadisticas');
      gotoxy(52,20);
      textcolor(blue);
      write('0- ');
      textcolor(white);
      writeln('Salir del programa');
      gotoxy(52,22);
      textcolor(blue);
      write('Respuesta: ');
      textcolor(white);
      readln(opcion);
      validar_opcion(opcion);
      case opcion of
        1:menu_alumno();
        2:menu_seguimiento();
        3:menu_listados();
        4:menu_estadisticas();
      end;
   until opcion=0;
   cerrar_archivo(arch_alumnos);
   cerrar_archivo(arch_evaluaciones);
end;


procedure menu_alumno();
var
   legajo: string;
   baja: boolean;
   opcion: byte;
   pos:byte;
begin
   while opcion <> 0 do
   begin
      clrscr;
      textcolor(white);
      gotoxy(40,10);
      write('*Menu ');
      textcolor(blue);
      writeln('Alumnos*');
      textcolor(white);
      gotoxy(30,12);
      write('Ingrese un legajo (0 para volver): ');
      readln(legajo);

      if legajo_valido(legajo) and (legajo= 0) then
         opcion := 0
      else
      begin
         buscar_legajo(a, legajo, baja, pos); 

         if pos = -1 then
         begin
            gotoxy(30,14);
            writeln('Legajo no encontrado.');
            writeln('¿Desea dar de alta este alumno? (1=Si, 0=No): ');
            readln(opcion);
            if opcion = 1 then
            begin
               clrscr;
               alta_alumnos(legajo);
            end;
         end
         else if baja then
         begin
            gotoxy(30,14);
            writeln('El alumno está dado de baja.');
            writeln('¿Desea reactivarlo? (1=Si, 0=No)');
            readln(opcion);
            if opcion = 1 then
            begin
               clrscr;
               alta_logica(legajo);
            end;
         end
         else
         begin
            gotoxy(30,14);
            writeln('1- Consultar alumno');
            gotoxy(30,15);
            writeln('2- Dar de baja alumno');
            gotoxy(30,16);
            writeln('0- Volver');
            gotoxy(30,18);
            write('Respuesta: ');
            readln(opcion);
            case opcion of
               1: begin 
                    clrscr; 
                    consulta_alumnos(legajo);
                  end;
               2: begin 
                    clrscr; 
                    baja_alumnos(legajo); 
                  end;
            end;
         end;
      end;
   end;
end;


