unit archivos;
{$mode ObjFPC}{$H+}
interface
const
     ruta_1='';
     ruta_2='';
     DISCAPACIDADES: ARRAY[1..5] OF STRING =
          ('PROBLEMAS DEL HABLA Y LENGUAJE',
           'DIFICULTAD PARA ESCRIBIR',
           'DIFICULTADES DE APRENDIZAJE VISUAL',
           'MEMORIA Y OTRAS DIFICULTADES DEL PENSAMIENTO',
           'DESTREZAS SOCIALES INADECUADAS');
uses
  Classes, SysUtils, UNIT_ARBOL;
type
  t_dato_alumnos=record
    legajo:string[10];
    ayn:string;
    fecha_nac:string[10];
    estado:boolean;
    discapacidades:array [1..5] of boolean;
  end;
  t_archivo_alumnos=file of t_dato_alumnos;
  t_dato_evaluaciones=record
    legajo:string;
    fecha_ev:string[10];
    valoracion:array [1..5] of 0..4;
    observacion:string[100];
  end;
  t_archivo_evaluaciones=file of t_dato_evaluaciones;

procedure crear_abrir (var archivo_1:t_archivo_alumnos); {LISTO}
procedure crear_abrir (var archivo_2:t_archivo_evaluaciones); {LISTO}
procedure cerrar_archivo (var archivo_1:t_archivo_alumnos); {LISTO}
procedure cerrar_archivo (var archivo_2:t_archivo_evaluaciones); {LISTO}
procedure leer_archivo (var archivo_1:t_archivo_alumnos; pos:integer; x:t_dato_alumnos);
procedure leer_archivo (var archivo_2:t_archivo_evaluaciones; pos:integer; x:t_dato_evaluaciones); {LISTO}
 {LISTO}
procedure escribir_archivo (var archivo_1:t_archivo_evaluaciones; pos:integer; x:t_dato_evaluaciones);
procedure escribir_archivo (var archivo_2:t_archivo_alumnos; pos:integer; x:t_dato_alumnos); {LISTO}
 {LISTO}
procedure cargar_legajo(var r:t_dato_alumnos); {LISTO}
procedure cargar_ayn(var r:t_dato_alumnos); {LISTO}
procedure fecha_nac (var r:t_dato_alumnos); {LISTO}
procedure tiene_disc (var r:t_dato_alumnos); {LISTO}
procedure agregar_archivo_alumno (var a:t_archivo_alumnos; legajo:string; pos:integer); {LISTO}
procedure alta_alumnos (var a: t_archivo_alumnos; legajo: string; var arb_leg: t_punt; var arb_ayn: t_punt); {}


implementation

function archivo_vacio (var archivo_1:t_archivo_alumnos): boolean;
begin
     archivo_vacio:=filesize(archivo_1)=0; 
end;

function archivo_vacio (var archivo_2:t_archivo_alumnos): boolean;
begin
     archivo_vacio:=filesize(archivo_2)=0; 
end;

procedure crear_abrir (var archivo_1:t_archivo_alumnos);
begin
     assign(archivo_1,ruta_1);
     {$I-}
     reset(archivo_1);
     {$I+}
     if IOResult <> 0 then
     begin
          rewrite(archivo_1);
     end;
end;

procedure crear_abrir (var archivo_2:t_archivo_evaluaciones);
begin
     assign(archivo_2,ruta_2);
     {$I-}
     reset(archivo_2);
     {$I+}
     if IOResult <> 0 then
     begin
          rewrite(archivo_2);
     end;
end;

procedure cerrar_archivo (var archivo_1:t_archivo_alumnos);
begin
     close(archivo_1);
end;

procedure cerrar_archivo (var archivo_2:t_archivo_evaluaciones);
begin
     close(archivo_2);
end;

procedure leer_archivo (var archivo_1:t_archivo_alumnos; pos:integer; var dato:t_dato_alumnos);
begin
     seek(archivo_1,pos);
     read(archivo_1,dato);
end;

procedure leer_archivo (var archivo_2:t_archivo_evaluaciones; pos:integer; var dato:t_dato_evaluaciones);
begin
     seek(archivo_2,pos);
     read(archivo_2,dato);
end;

procedure escribir_archivo (var archivo_1:t_archivo_alumnos; pos:integer; var dato:t_dato_alumnos);
begin
     seek(archivo_1,pos);
     write(archivo_1,dato);
end;

procedure escribir_archivo (var archivo_2:t_archivo_evaluaciones; pos:integer; var dato:t_dato_evaluaciones);
begin
     seek(archivo_2,pos);
     write(archivo_2,dato);
end;


{PARTE ALUMNOS}

procedure cargar_legajo(var r:t_dato_alumnos);
var
   legajo:string[10];
begin
     write('Por favor ingrese el legajo: ');
     readln(legajo);
     while not(legajo_valido(legajo)) do
     begin
       writeln('Escriba un legajo valido');
       readln(legajo);
     end;
     r.legajo:=legajo;
end;

procedure cargar_ayn(var r:t_dato_alumnos);
var
   ayn:string;
begin
     write('Por favor ingrese el apellido y nombre: ');
     readln(ayn);
     while not(escadena(ayn)) do
     begin
       writeln('Escriba un apellido y nombre valido: ');
       readln(ayn);
     end;
     r.ayn:=ayn;
end;

procedure fecha_nac (var r:t_dato_alumnos);
var
   f:string[10];
begin
     writeln('Por favor ingrese la fecha de nacimiento: (dd/mm/aaaa) ');
     readln(f);
     while not(fecha_valida(f)) do
     begin
       writeln('Escriba una fecha valida: ');
       readln(f);
     end;
     r.fecha_nac:=f;
end;

procedure tiene_disc (var r:t_dato_alumnos);
var
   op:char;
begin
       writeln('Marque las discapacidades que presenta');
       writeln('"V" (verdadero)');
       writeln('"F" (falso)');
     for i:= 1 to 5 do
     begin
       write(discapacidad[i], '; ' );
       readln(op);
       while (upcase(op)<>'V') and (upcase(op)<>'F') do
       begin
         writeln('Por favor, ingrese solamente "V" o "F": ');
         readln(op);
       end;
       if upcase(op) = 'V' then
          r.discapacidades[i]:=true
       else
           r.discapacidades[i]:=false;
     end;
end;

procedure mostrar_registro (x:t_dato_alumnos);
var
i:byte;
begin
  writeln('Legajo: ', x.legajo);
  writeln('Apellido y Nombre: ', x.ayn);
  writeln('Fecha Nacimiento: ', x.fecha_nac);
  write('Estado: ');
  if x.estado = true then
    writeln('Activo')
  else
    writeln('De Baja');
  writeln('Dificultades que presenta:');
for i:= 1 to 5 do
  begin
    if x.discapacidades[i] = true then
    begin
      writeln(' - ', DISCAPACIDADES[i]);
    end;
  end;
end;
end;

procedure cargar_registro (var r:t_dato_alumnos, legajo: string);
begin
     r.legajo:=legajo;
     cargar_ayn(r);
     fecha_nac(r);
     tiene_disc(r);
     r.estado:=true;
end;

procedure agregar_archivo_alumno (var a:t_archivo_alumnos; legajo:string; pos:integer; var r: t_dato_alumnos);
begin
     cargar_registro(r, legajo);
     seek(a,pos);
     write(a,r);
end;

procedure alta_alumnos (var a: t_archivo_alumnos; legajo: string; var arb_leg:t_punt, arb_ayn: t_punt);
var
     pos:integer;
     dato_ayn,x,dato_leg:t_dato_arbol;
     r:t_dato_alumnos;
     encontrado: boolean;
     op:char;
begin
     encontrado := false;
     pos:=0;
     PREORDEN(arb_leg, legajo, encontrado, x);
     if encontrado=false then
     begin
          pos:=filesize(a);
          agregar_archivo_alumno(a, legajo, pos, r);

          dato_leg.clave := r.legajo;
          dato_leg.pos_arch := pos;
          carga_arbol_alum(arb_leg ,dato_leg);

          dato_ayn.clave := r.ayn;
          dato_ayn.pos_arch := pos;
          carga_arbol_alum(arb_ayn ,dato_ayn);
     end
     else
     begin
          pos:=x.pos_arch
          leer_archivo(a, pos,r);
          mostrar_registro(r);
          if y.estado = true then
               writeln('El alumno ya se encuentra registrado y dado de alta')
          else
          begin
               writeln('El alumno se encuentra registrado pero esta dado de baja')
               writeln('¿Desea darlo de alta? S/N');
               readln(op);
               if upcase(op)='S'  then
               begin
                    clrscr;
                    y.estado:=true
                    escribir_archivo(a,pos,y);
                    writeln('Alumno agregado con exito');
               end;
          end;       
     end;
end;

procedure buscar_legajo(var a:t_archivo_alumnos; arb_leg:t_punt; var arb_ayn:t_punt ; legajo:string);
var
y:t_dato_alumnos;
x:t_dato_arbol;
encontrado:boolean;
pos:integer;
op:char;
begin
     encontrado := false;
     pos=:0;
     PREORDEN(arb_leg, legajo, encontrado, x);
     if encontrado=true then
     begin
          pos:=x.pos_arch
          leer_archivo(a, pos,y);
          mostrar_registro(y);
     end
     else
     begin
          writeln('Alumno no encontrado');
          writeln('¿Desea agregarlo? S/N ');
          readln(op);
          if upcase(op)='S'  then
          begin
               clrscr;
               alta_alumnos(a, legajo, arb_leg, arb_ayn);
               writeln('Alumno agregado con exito');
          end;
     end;
end;

procedure baja_alumnos(var a:t_archivo_alumnos; arb_leg:t_punt; var arb_ayn:t_punt ; legajo:string);
var
     y:t_dato_alumnos;
     x:t_dato_arbol
     encontrado:boolean;
     pos:integer;
     op:char;
begin
     encontrado := false;
     pos=:0;
     PREORDEN(arb_leg, legajo, encontrado, x);
     if encontrado=true then
     begin
          pos:=x.pos_arch
          leer_archivo(a, pos, y);
          if y.estado = true then
          begin
               y.estado:=false;
               escribir_archivo(a,pos,y);
               writeln('Alumno dado de baja con exito');
          end
          else
               writeln('El alumno ya se encuentra dado de baja');
     end
     else
           writeln('El alumno no se encuentra en el sistema');
end;

procedure consulta_alumnos(var a:t_archivo_alumnos; arb_leg:t_punt; var arb_ayn:t_punt ; legajo:string);
var
     y:t_dato_alumnos;
     x:t_dato_arbol
     encontrado:boolean;
     pos:integer;
     op:char;
begin
     encontrado := false;
     pos=:0;
     PREORDEN(arb_leg, legajo, encontrado, x);
     if encontrado=true then
     begin
          pos:=x.pos_arch
          leer_archivo(a, pos, y);
          mostrar_registro(y);
     end
     else
     begin
          writeln('Alumno no encontrado');
          writeln('¿Desea agregarlo? S/N ');
          readln(op);
          if upcase(op)='S'  then
          begin
               clrscr;
               alta_alumnos(a, legajo, arb_leg, arb_ayn);
               writeln('Alumno agregado con exito');
          end;
     end;     
end;

procedure modificar_alumno(var a:t_archivo_alumnos; arb_leg:t_punt; var arb_ayn:t_punt ; legajo:string);
var
     y:t_dato_alumnos;
     x:t_dato_arbol
     encontrado:boolean;
     pos:integer;
     op:char;
begin
     encontrado := false;
     pos=:0;
     PREORDEN(arb_leg, legajo, encontrado, x);
     if encontrado=true then
     repeat
          gotoxy(15, 6); 
          writeln(¿Que desea modificar?);
          gotoxy(15, 8); 
          writeln('1- Apellido y Nombre:');
          gotoxy(15, 10); 
          writeln('2- Fecha de Nacimiento: ');
          gotoxy(15, 12); 
          writeln('3- Discapacidades: ');
          writeln('0- Salir');
          read(op);
          case op of
               1:begin
                    clrscr;
                    writeln('Modificar apellido y nombre: ');
                    readln(ayn);
                    while not(escadena(ayn)) do
                    begin
                         writeln('ingrese un nombre valido');
                         readln(ayn);
                    end;
                    r.ayn:=ayn;
               end;
               2:begin
                    clrscr;
                    writeln('Modificar fecha de nacimiento: ');
                    readln(fecha);
                    while not(fecha_valida(fecha)) do
                    begin
                         writeln('ingrese una fecha valida');
                         readln(fecha);
                    end;
                    r.fecha:=fecha;
               end;
               3:begin
                    clrscr;
                    writeln('Modificar discapacidades:');
                    for i := 1 to 5 do
                    begin
                         write(DISCAPACIDADES[i], ' (V/F): ');
                         readln(disc);
                         if upcase(disc)='V' then 
                              r.discapacidades[i] :=true;
                         else
                              r.discapacidades[i] :=false;
               end;
          end;
          until op=0;
          seek(a,pos);
          write(a,r);
          writeln('Datos modificados correctamente.');
          readkey;
end;

{PARTE SEGUIMIENTO EVALUACIONES}


procedure alta_evaluacion (var a:t_archivo_alumnos;var a1:t_archivo_evaluaciones);
var
     legajo:string;
     pos,i, op:byte;
     r:t_dato_alumnos;
     x:t_dato_evaluaciones;
     baja:boolean;
     val:0..4;
     fecha_ev:string[10];
     observacion:string[100];
begin
     cargar_legajo(legajo);
     buscar_legajo(a,legajo,baja,pos);
     if r.estado = true then
     begin
          seek(a,pos);
          read(a,r);
          x.legajo:= legajo;
          writeln('Ingrese la fecha actual: ');
          realdn(fecha_ev);
          if fecha_valida(fecha_ev) then
          begin
               for i := 1 to 5 do
               begin
                    if r.discapacidades[i]= true then
                    begin
                         writeln(DISCAPACIDADES[i]);
                         writeln('Ingrese la valoracion del dia: ');
                         readln (val);
                         x.valoracion[i] := val;
                    end;
               end;
          end;
          writeln('Ingrese la observacion del dia: ');
          readln(observacion);
          x.fecha_ev := fecha_ev;
          x.observacion:= observacion;
          seek(a1,filesize(a1));
          write(a1,x);
     end
     else
     begin
          if pos=-1 then
          begin
               writeln('El legajo ingresado no existe');
               writeln('¿Desea darlo de alta?     1-Si|0-No);
               readln(op);
               case op of
                    1: begin
                         alta_alumnos(a, legajo, arb_ayn, arb_leg);
                         alta_evaluacion(a, a1);
                       end;

                    0: menu_principal;
               end;
          end
          else
          begin
               writeln('El legajo ingresado esta dado de baja');
               writeln('¿Desea darlo de alta?     1-Si|0-No);
               readln(op);
               case op of
                    1:begin 
                         alta_logica(a,legajo);
                         alta_evaluacion(a,a1);
                      end;
                    0: menu_principal;
               end;
          end;
     end;
end;
end;

{ARBOLES}

{GENERA ARBOL ALUMNO CARGANDO EL ARCHIVO}
procedure genera_arboles_alum(var a:t_archivo_alumos; var raiz, raiz_2:t_punt);
var
   x:t_dato_alumnos;
   i,j:byte;
begin
  crear_arbol(raiz);
  crear_arbol(raiz_2);
  j:=filesize(a);
  if j<>0 then
  begin
    for i:=0 to j-1 do
    begin
      seek(a,i);
      read(a,x);
      carga_arbol_alum(raiz,x.num_legajo,i);
      carga_arbol_alum(raiz_2,x.ayn,i);
    end;
  end;
end;   

{GENERA ARBOL EVALUACIONES CARGANDO EL ARCHIVO}
procedure genera_arbol_eval(var a:t_arch_eval; var raiz:t_punt);
var
   x:t_dato_eval;
   i,j:byte;
begin
  crear_arbol(raiz);
  j:=filesize(a);
  if j<>0 then
  begin
    for i:=0 to j-1 do
    begin
      seek(a,i);
      read(a,x);
      carga_arbol_eval(raiz,(x.fecha_ev+' '+x.num_legajo),i);
    end;
  end;
end;     

{AGREGA UNA NUEVA EVALUACION AL ARBOL}
procedure carga_arbol_eval(VAR raiz:t_punt; X:t_dato_arbol);;
begin
  agregar_arbol_eval(raiz,x);
end;

{AGREGA UN ALUMNO AL ARBOL}
procedure carga_arbol_alum(VAR raiz:t_punt; X:t_dato_arbol);
begin
  agregar(raiz,x);
end;    

{CUANDO INICIA EL PROGRAMA CREA LOS ARBOLES DIRECTAMENTE}
Procedure arbol_en_memoria(var archivo_1:t_archivo_alumnos; var archivo_2:t_archivo_evaluaciones; var raiz, raiz_2, raiz_3:t_punt);
begin
   crear_abrir(archivo_1);
   crear_abrir_2(archivo_2);
   if not (archivo_vacio(archivo_1)) then
   genera_arboles_alum(archivo_1,raiz,raiz_2)
   else
   begin
     crear_arbol(raiz);
     crear_arbol(raiz_2);
   end;
   if not (archivo_vacio(archivo_2)) then
    genera_arbol_eval(archivo_2,raiz_3)
   else
    crear_arbol(raiz_3);
end;     








