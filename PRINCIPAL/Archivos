unit archivos;
{$mode ObjFPC}{$H+}
interface
const
     ruta_1='';
     ruta_2='';
     DISCAPACIDADES: ARRAY[1..5] OF STRING =
          ('PROBLEMAS DEL HABLA Y LENGUAJE',
           'DIFICULTAD PARA ESCRIBIR',
           'DIFICULTADES DE APRENDIZAJE VISUAL',
           'MEMORIA Y OTRAS DIFICULTADES DEL PENSAMIENTO',
           'DESTREZAS SOCIALES INADECUADAS');
uses
  Classes, SysUtils;
type
  t_dato_alumnos=record
    legajo:string[10];
    ayn:string;
    fecha_nac:string[10];
    estado:boolean;
    discapacidades:array [1..5] of boolean;
  end;
  t_archivo_alumnos=file of t_dato_alumnos;
  t_dato_evaluaciones=record
    legajo:string;
    fecha_ev:string[10];
    valoracion:array [1..5] of 0..4;
    observacion:string[100];
  end;
  t_archivo_evaluaciones=file of t_dato_evaluaciones;

procedure crear_abrir (var archivo_1:t_archivo_alumnos);
procedure crear_abrir (var archivo_2:t_archivo_evaluaciones);
procedure cerrar_archivo (var archivo_1:t_archivo_alumnos);
procedure cerrar_archivo (var archivo_2:t_archivo_evaluaciones);
procedure leer_archivo (var archivo_1:t_archivo_alumnos);
procedure escribir_archivo (var archivo_2:t_archivo_evaluaciones);
procedure cargar_legajo(var r:t_dato_alumnos);
procedure cargar_ayn(var r:t_dato_alumnos);
procedure fecha_nac (var r:t_dato_alumnos);
procedure tiene_disc (var r:t_dato_alumnos);
procedure alta_alumnos (var a:t_archivo_alumnos,legajo:integer);

implementation

procedure crear_abrir (var archivo_1:t_archivo_alumnos);
begin
     assign(archivo_1,ruta_1);
     {$I-}
     reset(archivo_1);
     {$I+}
     if IOResult <> 0 then
     begin
          rewrite(archivo_1);
     end;
end;

procedure crear_abrir (var archivo_2:t_archivo_evaluaciones);
begin
     assign(archivo_2,ruta_2);
     {$I-}
     reset(archivo_2);
     {$I+}
     if IOResult <> 0 then
     begin
          rewrite(archivo_2);
     end;
end;

procedure cerrar_archivo (var archivo_1:t_archivo_alumnos);
begin
     close(archivo_1);
end;

procedure cerrar_archivo (var archivo_2:t_archivo_evaluaciones);
begin
     close(archivo_2);
end;

procedure leer_archivo (var archivo_1:t_archivo_alumnos; pos:byte; var dato:t_dato);
begin
     seek(archivo_1,pos);
     read(archivo_1,dato);
end;

procedure leer_archivo (var archivo_2:t_archivo_evaluaciones; pos:byte; var dato:t_dato);
begin
     seek(archivo_2,pos);
     read(archivo_2,dato);
end;

procedure escribir_archivo (var archivo_1:t_archivo_alumnos; pos:byte; var dato:t_dato);
begin
     seek(archivo_1,pos);
     write(archivo_1,dato);
end;

procedure escribir_archivo (var archivo_2:t_archivo_evaluaciones; pos:byte; var dato:t_dato);
begin
     seek(archivo_2,pos);
     write(archivo_2,dato);
end;


{PARTE ALUMNOS}

procedure cargar_legajo(var r:t_dato_alumnos);
var
   legajo:string[10];
begin
     write('Por favor ingrese el legajo: ');
     readln(legajo);
     while not(legajo_valido(legajo)) do
     begin
       writeln('Escriba un legajo valido');
       readln(legajo);
     end;
     r.legajo:=legajo;
end;

procedure cargar_ayn(var r:t_dato_alumnos);
var
   ayn:string;
begin
     write('Por favor ingrese el apellido y nombre: ');
     readln(ayn);
     while not(escadena(ayn)) do
     begin
       writeln('Escriba un apellido y nombre valido: ');
       readln(ayn);
     end;
     r.ayn:=ayn;
end;

procedure fecha_nac (var r:t_dato_alumnos);
var
   f:string[10];
begin
     writeln('Por favor ingrese la fecha de nacimiento: (dd/mm/aaaa) ');
     readln(f);
     while not(fecha_valida(f)) do
     begin
       writeln('Escriba una fecha valida: ');
       readln(f);
     end;
     r.fecha_nac:=f;
end;

procedure tiene_disc (var r:t_dato_alumnos);
var
   op:char;
begin
       writeln('Marque las discapacidades que presenta');
       writeln('"V" (verdadero)');
       writeln('"F" (falso)');
     for i:= 1 to 5 do
     begin
       write(discapacidad[i], '; ' );
       readln(op);
       while (upcase(op)<>'V') and (upcase(op)<>'F') do
       begin
         writeln('Por favor, ingrese solamente "V" o "F": ');
         readln(op);
       end;
       if upcase(op) = 'V' then
          r.discapacidades[i]:=true
       else
           r.discapacidades[i]:=false;
     end;
end;

procedure alta_alumnos (var a:t_archivo_alumnos, legajo:string);
var
   r:t_dato_alumnos;
   pos:byte;
begin
     r.legajo:=legajo;
     cargar_ayn(r);
     fecha_nac(r);
     tiene_disc(r);
     r.estado:=true;
     pos:=filesize(a);
     seek(a,pos);
     write(a,r);
end;

procedure buscar_legajo(var a:t_archivo_alumnos; legajo: string; var baja: boolean; var pos:byte);
var
  r: t_dato_alumnos;
  encontrado:boolean;
begin
  encontrado := false;
  baja := false;
  pos=:0;
  while (not eof(a)) and (encontrado=false) do
  begin
    seek(a,pos)
    read(a, r);
    if r.legajo = legajo then
      baja := r.estado
      encontrado:=true;
    else
          pos:=pos+1;
  end;
  if not encontrado then
    pos := -1;
end;

procedure baja_alumnos (var a:t_archivo_alumnos; legajo:string);
var
r:t_dato_alumnos;
begin

     r.estado := false;
end;  

procedure baja_alumnos (var a:t_archivo_alumnos; legajo:string);
var
  r: t_dato_alumnos;
  pos: integer;
  encontrado: boolean;
begin
  encontrado := false;
  pos := 0;
  while (not eof(a)) and (not encontrado) do
  begin
    seek(a,pos);
    read(a, r);
    if r.legajo = legajo then
      encontrado := true
    else
      pos := pos + 1;
  end;
  if encontrado then
  begin
    r.estado := false; 
    seek(a, pos);
    write(a, r); 
  end;
end;

procedure alta_logica (var a:t_archivo_alumnos; legajo:string);
var
  r: t_dato_alumnos;
  pos: integer;
  encontrado: boolean;
begin
  encontrado := false;
  pos := 0;
  while (not eof(a)) and (not encontrado) do
  begin
    seek(a,pos);
    read(a, r);
    if r.legajo = legajo then
      encontrado := true
    else
      pos := pos + 1;
  end;
  if encontrado then
  begin
    r.estado := true; 
    seek(a, pos);
    write(a, r); 
  end;
end;

procedure consulta_alumnos (var a:t_dato_alumnos; legajo:string; pos:byte; var r:t_dato_alumnos; );
var
     i:byte;
begin
     seek(a,pos)
     read(a,r)
     gotoxy(3, 2); 
     writeln('Legajo: ', r.legajo);
     gotoxy(3, 4); 
     writeln('Apellido y Nombre: ', r.ayn);
     gotoxy(3, 6); 
     writeln('Fecha de Nacimiento: ', r.fecha_nac);
     gotoxy(3, 8); 
     if r.estado then
          writeln('Estado: Activo')
     else
          writeln('Estado: Baja');

     gotoxy(10, 10); 
     writeln('Discapacidades:');
     for i := 1 to 5 do
     begin
     gotoxy(12, 10 + i);
     if r.discapacidades[i] then
          writeln('-', DISCAPACIDADES[i]);
     end;
     writeln('Desea modificar alguna informacion ?')
     writeln ('1-Si | 0-No')
     readln(op);
     repeat
     case op of 
     1:
     begin
     modificar_alumno(a, pos, r);
     end;
     until op = 0;
  end;

procedure modificar_alumno (var a:t_archivo_alumnos; pos:byte; var r:t_dato_alumnos;);
var
     op, i:byte;
     fecha:string[10];
     ayn:string[50];
begin
     repeat
     gotoxy(15, 6); 
     writeln(¿Que desea modificar?);
     gotoxy(15, 8); 
     writeln('1- Apellido y Nombre:');
     gotoxy(15, 10); 
     writeln('2- Fecha de Nacimiento: ');
     gotoxy(15, 12); 
     writeln('3- Discapacidades: ');
     writeln('0- Salir');
     read(op);
     case op of
          1:begin
               clrscr;
               writeln('Modificar apellido y nombre: ');
               readln(ayn);
               while not(escadena(ayn)) do
               begin
                    writeln('ingrese un nombre valido');
                    readln(ayn);
               end;
               r.ayn:=ayn;
            end;
          2:begin
               clrscr;
               writeln('Modificar fecha de nacimiento: ');
               readln(fecha);
               while not(fecha_valida(fecha)) do
               begin
                    writeln('ingrese una fecha valida');
                    readln(fecha);
               end;
               r.fecha:=fecha;
            end;
          3:begin
               clrscr;
               writeln('Modificar discapacidades:');
               for i := 1 to 5 do
               begin
                    write(DISCAPACIDADES[i], ' (V/F): ');
                    readln(disc);
                    if upcase(disc)='V' then 
                         r.discapacidades[i] :=true;
                    else
                         r.discapacidades[i] :=false;
            end;
     end;
     until op=0;
     seek(a,pos);
     write(a,r);
     writeln('Datos modificados correctamente.');
     readkey;

end;

{PARTE SEGUIMIENTO EVALUACIONES}


procedure alta_evaluacion (var a:t_archivo_alumnos;var a1:t_archivo_evaluaciones);
var
     legajo:string;
     pos,i, op:byte;
     r:t_dato_alumnos;
     x:t_dato_evaluaciones;
     baja:boolean;
     val:0..4;
     fecha_ev:string[10];
     observacion:string[100];
begin
     cargar_legajo(legajo);
     buscar_legajo(a,legajo,baja,pos);
     if r.estado = true then
     begin
          seek(a,pos);
          read(a,r);
          x.legajo:= legajo;
          writeln('Ingrese la fecha actual: ');
          realdn(fecha_ev);
          if fecha_valida(fecha_ev) then
          begin
               for i := 1 to 5 do
               begin
                    if r.discapacidades[i]= true then
                    begin
                         writeln(DISCAPACIDADES[i]);
                         writeln('Ingrese la valoracion del dia: ');
                         readln (val);
                         x.valoracion[i] := val;
                    end;
               end;
          end;
          writeln('Ingrese la observacion del dia: ');
          readln(observacion);
          x.fecha_ev := fecha_ev;
          x.observacion:= observacion;
          seek(a1,filesize(a1));
          write(a1,x);
     end
     else
     begin
          if pos=-1 then
          begin
               writeln('El legajo ingresado no existe');
               writeln('¿Desea darlo de alta?     1-Si|0-No);
               readln(op);
               case op of
                    1: begin
                         alta_alumnos(a,legajo);
                         alta_evaluacion(a,a1);
                       end;

                    0: menu_principal;
               end;
          end
          else
          begin
               writeln('El legajo ingresado esta dado de baja');
               writeln('¿Desea darlo de alta?     1-Si|0-No);
               readln(op);
               case op of
                    1:begin 
                         alta_logica(a,legajo);
                         alta_evaluacion(a,a1);
                      end;
                    0: menu_principal;
               end;
          end;
     end;
end;




end;








end. 
